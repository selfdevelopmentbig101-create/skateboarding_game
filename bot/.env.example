# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Token from @BotFather (/newbot).
BOT_TOKEN=<YOUR_BOT_TOKEN>
# HTTPS address where the game/ folder is hosted.
MINI_APP_URL=<YOUR_MINI_APP_URL>

# Optional, only if the bot logs "Timed out" / network errors:
# FORCE_IPV4=1
# TELEGRAM_PROXY=http://127.0.0.1:7890
